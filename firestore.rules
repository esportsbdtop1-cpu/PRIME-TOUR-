rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'nibirgaming07@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','email','balance','createdAt','phone','photoURL'])
        && request.resource.data.balance == 0
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','photoURL'])
      ) || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.balance < resource.data.balance
      );
      allow delete: if isAdmin();
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
        && request.resource.data.joined == resource.data.joined + 1
        && existsAfter(/databases/$(database)/documents/joins/$(request.auth.uid + '_' + tid))
        && getAfter(/databases/$(database)/documents/joins/$(request.auth.uid + '_' + tid)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/joins/$(request.auth.uid + '_' + tid)).data.tournamentId == tid
      );
    }

    match /joins/{joinId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.tournamentId is string
        && request.resource.data.paid is number
        && request.resource.data.paid >= 0;
      allow update, delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /media/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /deposits/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000
        && request.resource.data.trx is string;
      allow update, delete: if isAdmin();
    }

    match /matches/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /results/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
